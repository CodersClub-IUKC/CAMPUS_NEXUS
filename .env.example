# ─────────────────────────────────────────────────────────────────────────────
# Campus Nexus — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# ── Hosts, CORS & CSRF ────────────────────────────────────────────────────────
ALLOWED_HOSTS=campusnexus.codersug.com
CSRF_TRUSTED_ORIGINS=https://campusnexus.codersug.com
# Set this after the separate React Member Portal hostname is created.
# Example only: https://member.campusnexus.codersug.com
MEMBER_PORTAL_ORIGIN=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# ── Django Secret Key ─────────────────────────────────────────────────────────
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-secret-key

# ── Production security toggles ───────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.production
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER_ENABLED=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ── Optional: Admin Login Rate Limiting ───────────────────────────────────────
# ENABLE_ADMIN_LOGIN_RATE_LIMIT=true
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_LOCKOUT_SECONDS=60

# ── Optional: Session & Cookie settings ───────────────────────────────────────
# SESSION_COOKIE_AGE=1800
# SESSION_EXPIRE_AT_BROWSER_CLOSE=true

# ── Optional: JWT lifetimes ───────────────────────────────────────────────────
# SIMPLE_JWT_ACCESS_TOKEN_MINUTES=15
# SIMPLE_JWT_REFRESH_TOKEN_DAYS=7
# SIMPLE_JWT_ROTATE_REFRESH_TOKENS=true
# SIMPLE_JWT_BLACKLIST_AFTER_ROTATION=true

# ── Optional: Static, media, logs ──────────────────────────────────────────────
# DJANGO_STATIC_ROOT=/home/codemsdx/campusnexus.codersug.com/staticfiles
# DJANGO_MEDIA_ROOT=/home/codemsdx/campusnexus.codersug.com/media
# DJANGO_LOG_LEVEL=INFO

# ── Optional: GitHub deploy webhook ───────────────────────────────────────────
# Disabled by default. Prefer cPanel/operator-triggered deploys unless reviewed.
# GITHUB_DEPLOY_WEBHOOK_ENABLED=false
# GITHUB_DEPLOY_WEBHOOK_SECRET=replace-with-github-webhook-secret
# GITHUB_DEPLOY_SCRIPT=/home/codemsdx/campusnexus.codersug.com/deploy.sh
